{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/QuestMasterService/QuestMasterService.slnx",
        "--nologo"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "watch backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "${workspaceFolder}/backend/QuestMasterService/src/QuestMasterService.Web/QuestMasterService.Web.csproj",
        "run",
        "--launch-profile",
        "http"
      ],
      "isBackground": true,
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "backend"
      }
    }
  ]
}
