{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug QuestMasterService.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build backend",
      "program": "${workspaceFolder}/backend/QuestMasterService/src/QuestMasterService.Web/bin/Debug/net10.0/QuestMasterService.Web.dll",
      "cwd": "${workspaceFolder}/backend/QuestMasterService/src/QuestMasterService.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5113"
      },
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
